# Copy this file to backend/.env and fill in real values.
# Never commit backend/.env — it holds secrets.

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_NAME=e_library
DB_USER=elibrary_app
DB_PASSWORD=change-me

# Flask session signing key (generate a long random hex string).
APP_SECRET_KEY=change-me-to-a-long-random-secret