{
  "name": "e-library",
  "version": "1.0.0",
  "description": "Full-stack digital library built with Flask and React",
  "private": true,
  "scripts": {
    "start": "cd backend && ..\\.venv\\Scripts\\python.exe run.py",
    "dev": "concurrently -n api,web \"cd backend && ..\\.venv\\Scripts\\python.exe run.py\" \"cd frontend && npm run dev\"",
    "backend": "cd backend && ..\\.venv\\Scripts\\python.exe run.py",
    "frontend": "cd frontend && npm run dev",
    "assets": "cd backend && ..\\.venv\\Scripts\\python.exe tools\\build_library_assets.py",
    "catalogue:remote": "cd backend && ..\\.venv\\Scripts\\python.exe tools\\build_remote_catalogue.py",
    "catalogue:fantasy": "cd backend && ..\\.venv\\Scripts\\python.exe tools\\build_fantasy_catalogue.py",
    "catalogue:subjects": "cd backend && ..\\.venv\\Scripts\\python.exe tools\\build_subject_catalogue.py",
    "catalogue:reclassify": "cd backend && ..\\.venv\\Scripts\\python.exe tools\\reclassify_remote_catalogue.py",
    "covers:public-domain": "cd backend && ..\\.venv\\Scripts\\python.exe tools\\fetch_public_domain_covers.py",
    "seed": "cd backend && ..\\.venv\\Scripts\\python.exe seed_library.py",
    "audit": "cd backend && ..\\.venv\\Scripts\\python.exe tools\\audit_library.py",
    "test": "cd backend && ..\\.venv\\Scripts\\python.exe -m pytest -q",
    "build": "cd frontend && npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
